rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SOMENTE PARA O EMULADOR LOCAL demo-zenos-local.
    // Mesmo em homologação, exige um utilizador autenticado no Auth Emulator.
    // NUNCA publicar estas regras como substituição das regras reais sem auditoria específica.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

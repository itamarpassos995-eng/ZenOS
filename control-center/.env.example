# Server only. Never add real secrets to git or chat.
CONTROL_CENTER_DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_HOST:5432/zenos_control_center_homologacao
CONTROL_CENTER_ORIGIN=https://YOUR_SEPARATE_HOMOLOGATION_HOST
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A 32-byte key encoded as base64, generated in the hosting secret manager.
CONTROL_CENTER_AUTH_KEY=
# Explicitly authorized verified Google email for initial owner only.
CONTROL_CENTER_BOOTSTRAP_EMAIL=
PORT=3000
# Set 0.0.0.0 only for HTTP container binding on the hosting platform.
# This is NOT a PostgreSQL inbound IP rule.
CONTROL_CENTER_BIND=127.0.0.1

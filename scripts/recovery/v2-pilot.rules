rules_version = '2';
// EMULATOR PILOT ONLY. Not a production replacement: commerce/fiscal rules
// need a separate compatibility audit. Never append to the current broad rule.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lojas/{store}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == store;
    }
  }
}

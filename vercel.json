{
  "rewrites": [
    {
      "source": "/loja/previa",
      "destination": "/index.html"
    },
    {
      "source": "/loja/:lojaId",
      "destination": "/commerce-homologacao.html"
    },
    {
      "source": "/vitrine/:lojaId",
      "destination": "/commerce-homologacao.html"
    }
  ],
  "headers": [
    {
      "source": "/recuperar.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

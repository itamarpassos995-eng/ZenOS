{
  "git": {
    "deploymentEnabled": {
      "fix/vipe-historical-fx1150-blind-cash-20261121": false
    }
  },
  "rewrites": [
    {
      "source": "/loja/previa",
      "destination": "/index.html"
    },
    {
      "source": "/loja/:lojaId",
      "destination": "/commerce-homologacao.html"
    },
    {
      "source": "/vitrine/:lojaId",
      "destination": "/commerce-homologacao.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
